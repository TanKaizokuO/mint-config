{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["sway/workspaces", "sway/mode", "custom/usage-cc", "custom/usage-cx"],
    "modules-center": ["clock"],
    "modules-right": ["group/perf", "group/conn", "group/power", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [], "5": [] }
    },

    "sway/window": {
        "max-length": 60,
        "format": "{title}",
        "icon": true,
        "icon-size": 16
    },

    "cpu": {
        "interval": 3,
        // CPU spikes briefly, so its cut-offs sit a bit higher than memory's
        "states": { "warning": 60, "critical": 85 },
        "format": "  {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 5,
        "states": { "warning": 60, "critical": 80 },
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "  {percent}%",
        "format-icons": ["", "", ""]
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "  wired",
        "format-disconnected": "  offline",
        "tooltip-format": "{essid}\n{ifname}: {ipaddr}\nClick: Wi-Fi controls",
        "on-click": "/usr/bin/python3 ~/.config/waybar/scripts/wifi_popover.py"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        // Built-in scroll (PulseAudio API) doesn't react on this PipeWire box,
        // so drive it through wpctl. -l 1.0 caps scroll-up at 100%.
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 50, "critical": 20 }
    },

    // Right side = separate pills by job: readings, connectivity, audio/power, tray.
    "group/perf":  { "orientation": "horizontal", "modules": ["cpu", "memory"] },
    "group/conn":  { "orientation": "horizontal", "modules": ["network"] },
    "group/power": { "orientation": "horizontal", "modules": ["backlight", "pulseaudio", "battery"] },

    // Left-side usage meters: two separate pills (5h % used on the bar, 5h + 7d on hover).
    "custom/usage-cc": {
        "exec": "~/.config/waybar/scripts/usage.py cc",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    },
    "custom/usage-cx": {
        "exec": "~/.config/waybar/scripts/usage.py cx",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip": false,
        "on-click": "~/.cargo/bin/daypane popup"
    },

    "tray": { "spacing": 8 }
}
